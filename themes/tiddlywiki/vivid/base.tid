title: $:/themes/tiddlywiki/vivid/base
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Vivid theme — base stylesheet
** Accent tokens live here so later animation work can reference them in one place.
*/
:root {
	--vivid-violet: #8b5cff;
	--vivid-cyan: #22d3ee;
	--vivid-magenta: #ff49db;
	--vivid-lime: #b4f461;
	--vivid-glass: rgba(255,255,255,0.045);
	--vivid-glass-strong: rgba(255,255,255,0.075);
	--vivid-glass-border: rgba(255,255,255,0.09);
	--vivid-radius: 16px;
	--vivid-radius-lg: 22px;
	--vivid-shadow: 0 10px 34px rgba(0,0,0,0.5);
	--vivid-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* Ambient gradient field behind everything — gives the glass something to refract */
html {
	background-color: <<colour page-background>>;
	background-image:
		radial-gradient(900px 600px at 100% -5%, rgba(139,92,255,0.22), transparent 60%),
		radial-gradient(820px 600px at -5% 110%, rgba(34,211,238,0.16), transparent 55%),
		radial-gradient(700px 520px at 50% 45%, rgba(255,73,219,0.07), transparent 60%);
	background-attachment: fixed;
}

/* ====================== SIDEBAR ====================== */

.tc-sidebar-header {
	padding-top: 1.2em;
}

/* Site title: bold gradient wordmark */
.tc-site-title {
	font-weight: 800;
	letter-spacing: -0.02em;
	font-size: 2.2em;
	line-height: 1.1;
	background: linear-gradient(135deg, var(--vivid-violet) 0%, var(--vivid-cyan) 100%);
	-webkit-background-clip: text;
	background-clip: text;
	-webkit-text-fill-color: transparent;
	color: transparent;
}

.tc-site-subtitle {
	color: <<colour sidebar-muted-foreground>>;
	font-size: 0.95em;
	margin-top: 0.25em;
	letter-spacing: 0.01em;
}

/* Search box: glassy pill with focus glow */
.tc-sidebar-header .tc-search input,
.tc-sidebar-header input.tc-edit-texteditor {
	background: var(--vivid-glass);
	border: 1px solid var(--vivid-glass-border);
	border-radius: 999px;
	padding: 0.55em 0.95em;
	color: <<colour sidebar-foreground>>;
	-webkit-backdrop-filter: blur(8px);
	backdrop-filter: blur(8px);
	transition: box-shadow 200ms var(--vivid-ease), border-color 200ms var(--vivid-ease), background 200ms var(--vivid-ease);
}

.tc-sidebar-header .tc-search input:focus,
.tc-sidebar-header input.tc-edit-texteditor:focus {
	outline: none;
	border-color: var(--vivid-violet);
	box-shadow: 0 0 0 3px rgba(139,92,255,0.25), 0 0 22px rgba(139,92,255,0.28);
	background: var(--vivid-glass-strong);
}

/* Page-control icon buttons: round glass chips that lift and glow on hover */
.tc-page-controls button {
	border-radius: 12px;
	padding: 6px;
	margin: 3px;
	transition: transform 180ms var(--vivid-ease), background 180ms var(--vivid-ease), box-shadow 180ms var(--vivid-ease);
}

.tc-page-controls button:hover {
	background: var(--vivid-glass-strong);
	transform: translateY(-2px);
	box-shadow: 0 6px 18px rgba(139,92,255,0.30);
}

.tc-page-controls button svg {
	fill: <<colour sidebar-controls-foreground>>;
	transition: fill 180ms var(--vivid-ease);
}

.tc-page-controls button:hover svg {
	fill: var(--vivid-magenta);
}

/*
** Sidebar tabs — each tab-set is ONE cohesive glass card: the button strip
** and the content share the same panel, so the tabs read as part of the
** content rather than a detached row of buttons. overflow:hidden clips the
** rounded corners so nothing (especially vertical tabs) overhangs.
*/
.tc-sidebar-lists .tc-tab-set {
	background: var(--vivid-glass);
	border: 1px solid var(--vivid-glass-border);
	border-radius: var(--vivid-radius);
	-webkit-backdrop-filter: blur(10px);
	backdrop-filter: blur(10px);
	box-shadow: var(--vivid-shadow);
	margin-top: 0.7em;
	overflow: hidden;
}

/* Horizontal button strip: a header divided from the content below */
.tc-sidebar-lists .tc-tab-buttons {
	display: flex;
	flex-wrap: wrap;
	gap: 0.1em;
	padding: 0.35em 0.5em 0;
	margin: 0;
	border-bottom: 1px solid var(--vivid-glass-border);
}

.tc-sidebar-lists .tc-tab-buttons button {
	position: relative;
	background: transparent;
	border: none;
	border-radius: 8px 8px 0 0;
	padding: 0.5em 0.85em;
	margin: 0;
	color: <<colour sidebar-tab-foreground>>;
	font-weight: 600;
	transition: color 160ms var(--vivid-ease), background 160ms var(--vivid-ease);
}

.tc-sidebar-lists .tc-tab-buttons button:hover {
	background: var(--vivid-glass);
	color: <<colour sidebar-muted-foreground-hover>>;
}

/* Selected horizontal tab: bright text + gradient underline sitting on the divider */
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected,
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected:hover {
	color: #ffffff;
	background: transparent;
	border: none;
	outline: none;
}

.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected::after {
	content: "";
	position: absolute;
	left: 0.5em;
	right: 0.5em;
	bottom: -1px;
	height: 3px;
	border-radius: 3px 3px 0 0;
	background: linear-gradient(90deg, var(--vivid-violet), var(--vivid-cyan));
}

/* Content shares the card — no separate floating box */
.tc-sidebar-lists .tc-tab-content {
	margin-top: 0;
	padding: 0.9em 1.05em;
}

/*
** Nested vertical tabs (e.g. the "More" tab). Flatten the inner tab-set so it
** is not a card-within-a-card, and lay the buttons out as a clean side rail
** that sits inside the outer card instead of overhanging it.
*/
.tc-sidebar-lists .tc-tab-content .tc-tab-set {
	background: transparent;
	border: none;
	border-radius: 0;
	box-shadow: none;
	-webkit-backdrop-filter: none;
	backdrop-filter: none;
	margin-top: 0;
	overflow: visible;
}

.tc-sidebar-lists .tc-tab-buttons.tc-vertical {
	display: block;
	padding: 0;
	margin-inline-end: 0.6em;
	border-bottom: none;
}

.tc-sidebar-lists .tc-tab-buttons.tc-vertical button {
	display: block;
	width: 100%;
	text-align: end;
	border: none;
	border-radius: 8px;
	padding: 0.4em 0.6em;
	margin: 0 0 0.2em 0;
	background: transparent;
	color: <<colour sidebar-tab-foreground>>;
}

.tc-sidebar-lists .tc-tab-buttons.tc-vertical button:hover {
	background: var(--vivid-glass);
}

.tc-sidebar-lists .tc-tab-buttons.tc-vertical button.tc-tab-selected {
	color: #0b0c14;
	border: none;
	background: linear-gradient(135deg, rgba(139,92,255,0.95), rgba(34,211,238,0.9));
}

.tc-sidebar-lists .tc-tab-buttons.tc-vertical button.tc-tab-selected::after {
	display: none;
}

.tc-sidebar-lists .tc-tab-content.tc-vertical {
	padding-top: 0;
	border-inline-start: 1px solid var(--vivid-glass-border);
}

/* Sidebar tiddler links */
.tc-sidebar-lists a.tc-tiddlylink {
	color: <<colour sidebar-tiddler-link-foreground>>;
	border-radius: 6px;
	padding: 1px 4px;
	transition: color 160ms var(--vivid-ease), background 160ms var(--vivid-ease);
}

.tc-sidebar-lists a.tc-tiddlylink:hover {
	color: <<colour sidebar-tiddler-link-foreground-hover>>;
	background: rgba(34,211,238,0.12);
	text-decoration: none;
}

/* Tag pills (used throughout, prominent in the sidebar Tags tab) */
.tc-tag-label {
	border-radius: 999px;
	padding: 0.18em 0.75em;
	font-weight: 600;
}

/* --- Sidebar polish (pass 2) --- */

/* Brighter default icon contrast for the page-control chips */
.tc-page-controls button svg {
	fill: #aeb4dd;
}

/* New-tiddler button promoted to a filled gradient action */
.tc-page-controls button[class*="new-tiddler"] {
	background: linear-gradient(135deg, var(--vivid-violet), var(--vivid-magenta));
	box-shadow: 0 6px 16px rgba(139,92,255,0.40);
}

.tc-page-controls button[class*="new-tiddler"] svg,
.tc-page-controls button[class*="new-tiddler"]:hover svg {
	fill: #0b0c14;
}

.tc-page-controls button[class*="new-tiddler"]:hover {
	background: linear-gradient(135deg, var(--vivid-violet), var(--vivid-magenta));
	transform: translateY(-2px);
	box-shadow: 0 8px 22px rgba(255,73,219,0.45);
}

/* A touch more breathing room around the control row */
.tc-page-controls {
	margin: 0.4em 0 0.9em;
}

/* ====================== STORY RIVER ====================== */

.tc-story-river {
	padding-top: 1em;
}

/* Tiddler frame: floating glass card */
.tc-tiddler-frame {
	background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.02));
	border: 1px solid var(--vivid-glass-border);
	border-radius: var(--vivid-radius-lg);
	-webkit-backdrop-filter: blur(12px);
	backdrop-filter: blur(12px);
	box-shadow: var(--vivid-shadow);
	padding: 1.4em 1.9em 1.6em;
	margin-bottom: 1.7em;
	position: relative;
	overflow: hidden;
	transition: transform 240ms var(--vivid-ease), box-shadow 240ms var(--vivid-ease), border-color 240ms var(--vivid-ease);
}

/* Saturated accent strip along the top edge of every card */
.tc-tiddler-frame::before {
	content: "";
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 3px;
	background: linear-gradient(90deg, var(--vivid-violet), var(--vivid-cyan), var(--vivid-magenta));
	opacity: 0.95;
}

.tc-tiddler-frame:hover {
	transform: translateY(-3px);
	border-color: rgba(139,92,255,0.40);
	box-shadow: 0 16px 44px rgba(0,0,0,0.55), 0 0 26px rgba(139,92,255,0.18);
}

.tc-tiddler-frame.tc-tiddler-edit-frame {
	border-color: rgba(139,92,255,0.45);
}

/* Title: subtle white-to-violet gradient wordmark */
.tc-tiddler-title .tc-title,
.tc-tiddler-title .tc-title a.tc-tiddlylink {
	font-weight: 800;
	letter-spacing: -0.01em;
	background: linear-gradient(120deg, #ffffff 0%, #c7b3ff 100%);
	-webkit-background-clip: text;
	background-clip: text;
	-webkit-text-fill-color: transparent;
	color: transparent;
}

/* Tiddler control icons glow magenta on hover */
.tc-tiddler-controls button svg {
	transition: fill 160ms var(--vivid-ease);
}

.tc-tiddler-controls button:hover svg {
	fill: var(--vivid-magenta);
}

/* Body links: violet with an animated underline that shifts to cyan */
.tc-tiddler-body a.tc-tiddlylink {
	color: <<colour tiddler-link-foreground>>;
	text-decoration: none;
	border-bottom: 1px solid rgba(139,92,255,0.40);
	transition: color 150ms var(--vivid-ease), border-color 150ms var(--vivid-ease);
}

.tc-tiddler-body a.tc-tiddlylink:hover {
	color: var(--vivid-cyan);
	border-bottom-color: var(--vivid-cyan);
}

/* Inline code and code blocks: rounded, mint on deep panel */
.tc-tiddler-body code {
	border-radius: 6px;
	padding: 0.08em 0.4em;
}

.tc-tiddler-body pre {
	border-radius: 12px;
	padding: 1em 1.1em;
}
